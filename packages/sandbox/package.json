    "@types/node": "^20",
    "archiver": "^7.0.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
