# AWS region + artifact bucket (same as the computer pipeline).
AWS_REGION=ap-southeast-1
MICROVM_BUCKET=

# IAM role the image builder assumes (needs s3:GetObject on the bucket + CloudWatch Logs).
MICROVM_BUILD_ROLE_ARN=

# Base image ARN (AL2023). List with: aws lambda-microvms list-managed-microvm-images
MICROVM_BASE_IMAGE_ARN=

# Golden image name + zip key (defaults shown).
# SANDBOX_IMAGE_NAME=wayfind-exec
# SANDBOX_ZIP_KEY=microvm-artifacts/wayfind-exec.zip

# Trust ceremony (03-publish-trust.ts): release bearer for POST /image-trust/publish.
# Ask the backend owner for the value; the published record is public to signed-in users.
# IMAGE_TRUST_SECRET=
# Api base override (defaults to the deployed wayfind-api URL).
# WAYFIND_API_URL=https://td4dfiwfkmwp32gyqfzxb7axly0kbrwg.lambda-url.ap-southeast-1.on.aws

# Credentials come from your normal AWS setup (env / ~/.aws/credentials) — not from here.
